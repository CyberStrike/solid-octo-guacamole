{
  "name": "@archive/mailer",
  "version": "0.0.0",
  "private": true,
  "description": "Mailer Worker: consumes the email queue and sends sign-in emails through Resend's batch API.",
  "type": "module",
  "main": "src/worker.ts",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
