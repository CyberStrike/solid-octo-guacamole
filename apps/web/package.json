  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "^5.20261029.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "~4.1.12",
    "wrangler": "4.156.0"
  },
  "dependencies": {
    "hono": "4.13.14"
  }
}
